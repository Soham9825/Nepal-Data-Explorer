# Playwright hotel collection foundation
# Keep disabled until a permitted source adapter and browser worker are configured.
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_MAX_CONCURRENCY=2

# Optional legitimate provider-supported proxy only. Do not use for evasion.
PLAYWRIGHT_PROXY_SERVER=
PLAYWRIGHT_PROXY_USERNAME=
PLAYWRIGHT_PROXY_PASSWORD=