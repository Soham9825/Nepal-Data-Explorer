# ------------------------------------------------------------------
# Nepal Data Explorer — environment configuration
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ------------------------------------------------------------------

# Django
# ------------------------------------------------------------------
# Required. Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Required. PostgreSQL connection string (SQLite is fine for local dev):
#   postgres://user:password@host:5432/dbname
#   sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# Absolute URL of the frontend (used for mail links / OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Email (optional — only needed for OTP / password-reset flows)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# OAuth (optional — add keys to enable Google / GitHub sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/accounts/github/callback